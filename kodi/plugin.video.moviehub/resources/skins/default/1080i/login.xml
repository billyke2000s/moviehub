<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!--
      Login dialog. Recreates the Movie Hub auth screen look:
        near-black background (#040406) with a soft purple glow,
        centered frosted panel, "MOVIE HUB" wordmark, purple accent button.
      Colours are set inline (Kodi skins use ARGB hex: AA RR GG BB).
    -->
    <defaultcontrol always="true">100</defaultcontrol>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <!-- full-bleed background -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>background.png</texture>
        </control>
        <!-- dim veil -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E6040406">white.png</texture>
        </control>

        <!-- centered panel -->
        <control type="group">
            <left>660</left><top>250</top>
            <width>600</width><height>580</height>

            <!-- frosted panel bg -->
            <control type="image">
                <left>0</left><top>0</top><width>600</width><height>580</height>
                <texture colordiffuse="14FFFFFF" border="28">panel.png</texture>
            </control>

            <!-- wordmark -->
            <control type="label">
                <left>0</left><top>44</top><width>600</width><height>60</height>
                <align>center</align><aligny>center</aligny>
                <font>font_hub_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>MOVIE HUB</label>
            </control>
            <!-- accent underline -->
            <control type="image">
                <left>260</left><top>108</top><width>80</width><height>4</height>
                <texture colordiffuse="FFD2AA67">white.png</texture>
            </control>

            <control type="label">
                <left>40</left><top>140</top><width>520</width><height>40</height>
                <align>center</align>
                <font>font_hub_sub</font>
                <textcolor>BDFFFFFF</textcolor>
                <label>Log in — your profiles follow you to every device.</label>
            </control>

            <!-- Username -->
            <control type="label">
                <left>60</left><top>210</top><width>480</width><height>28</height>
                <font>font_hub_label</font>
                <textcolor>BDFFFFFF</textcolor>
                <label>Username</label>
            </control>
            <control type="edit" id="100">
                <left>60</left><top>240</top><width>480</width><height>56</height>
                <texturefocus colordiffuse="1FFFFFFF" border="12">button-focus.png</texturefocus>
                <texturenofocus colordiffuse="0DFFFFFF" border="12">button.png</texturenofocus>
                <font>font_hub_input</font>
                <textcolor>FFFFFFFF</textcolor>
                <onup>103</onup>
                <ondown>101</ondown>
            </control>

            <!-- Password -->
            <control type="label">
                <left>60</left><top>312</top><width>480</width><height>28</height>
                <font>font_hub_label</font>
                <textcolor>BDFFFFFF</textcolor>
                <label>Password</label>
            </control>
            <control type="edit" id="101">
                <left>60</left><top>342</top><width>480</width><height>56</height>
                <texturefocus colordiffuse="1FFFFFFF" border="12">button-focus.png</texturefocus>
                <texturenofocus colordiffuse="0DFFFFFF" border="12">button.png</texturenofocus>
                <font>font_hub_input</font>
                <textcolor>FFFFFFFF</textcolor>
                <onup>100</onup>
                <ondown>102</ondown>
            </control>

            <!-- Log in button -->
            <control type="button" id="102">
                <left>60</left><top>430</top><width>480</width><height>60</height>
                <texturefocus colordiffuse="FFFFFFFF" border="14">button.png</texturefocus>
                <texturenofocus colordiffuse="FFD2AA67" border="14">button.png</texturenofocus>
                <font>font_hub_button</font>
                <textcolor>FF090A0C</textcolor>
                <align>center</align>
                <label>Log In</label>
                <onup>101</onup>
                <ondown>103</ondown>
            </control>

            <!-- Create account link -->
            <control type="button" id="103">
                <left>60</left><top>502</top><width>480</width><height>44</height>
                <texturefocus colordiffuse="1FFFFFFF" border="12">button.png</texturefocus>
                <texturenofocus colordiffuse="0DFFFFFF" border="12">button.png</texturenofocus>
                <font>font_hub_label</font>
                <textcolor>BDFFFFFF</textcolor>
                <align>center</align>
                <label>Create a new account</label>
                <onup>102</onup>
                <ondown>100</ondown>
            </control>
        </control>
    </controls>
</window>
