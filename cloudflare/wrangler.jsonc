{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviehub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moviehub",
      "database_id": "moviehub-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "moviehub-avatars"
    }
  ]
}
