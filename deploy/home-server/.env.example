# Server's actual LAN IPv4 address (not your TV's address or localhost).
# If using Proxmox, this is the IP of the Linux VM/container running Docker.
SERVER_LAN_IP=192.168.1.50
TZ=Europe/London

# Replace these before starting. Use a unique, strong password.
MONGO_ROOT_USER=masqueradarr
MONGO_ROOT_PASS=REPLACE_WITH_A_RANDOM_PASSWORD

# Persistent secret for Nuvio stream signatures; openssl rand -hex 32
NUVIO_APP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
